# Copy to config.env and fill in. NEVER upload config.env to GitHub.

# ---- Broker: angel or dhan ----
BROKER=angel
ANGEL_API_KEY=YOUR_ANGEL_API_KEY
ANGEL_CLIENT_CODE=YOUR_CLIENT_CODE
ANGEL_MPIN=YOUR_MPIN
ANGEL_TOTP_SECRET=YOUR_TOTP_SECRET
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=

# ---- Telegram (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Site password (required on Render) ----
APP_PASSWORD=

# ---- Strategy settings (defaults shown) ----
RISK_PER_TRADE=2500          # rupees per trade incl. costs; bigger risk = skipped
MAX_LOTS=1
MIN_SCORE=60                 # watchlist quality grade (not a win chance)
TOP_PER_SIDE=10
TARGET_DELTA=0.45
MAX_SPREAD_PCT=3             # skip options with a wider bid-ask spread
MIN_OPTION_VOLUME_LOTS=20    # skip options with fewer lots traded today
VOLUME_PACE=1.0              # stock volume vs its normal pace at that time of day
MIN_DTE=3                    # roll to next expiry when fewer days are left
INDEX_FILTER=1               # 1 = don't trade against NIFTY
MAX_ACTIVE=4
ENTRY_START=09:25
NO_NEW_ENTRY=14:30
SQUARE_OFF=15:15
QUOTE_INTERVAL_SECONDS=5
PORT=8765
