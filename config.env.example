# Copy this file to config.env and fill it in. Never upload config.env to GitHub.

# Which broker feeds live prices: angel or dhan
BROKER=angel

# ---- Angel One SmartAPI ----
# API key: smartapi.angelbroking.com > My Profile > Create an App (Market Feeds type)
ANGEL_API_KEY=YOUR_ANGEL_API_KEY
# Your Angel One client ID (e.g. A123456)
ANGEL_CLIENT_CODE=YOUR_CLIENT_CODE
# The 4-digit MPIN you use to log in to the Angel One app
ANGEL_MPIN=YOUR_MPIN
# TOTP secret: smartapi.angelbroking.com/enable-totp > the text key under the QR code
ANGEL_TOTP_SECRET=YOUR_TOTP_SECRET

# ---- Dhan (only if BROKER=dhan) ----
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ---- Telegram alerts (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_THREAD_ID=

# Server-side alerts work even with the browser closed
SERVER_ALERTS=1
MIN_SCORE=60
TOP_PER_SIDE=10
QUOTE_INTERVAL_SECONDS=5
PORT=8765
# Required when hosting publicly (Render): the site asks for this password
APP_PASSWORD=
